# Copy to .env.local (gitignored via *.local) and fill in from your Supabase
# project settings → API. Both are safe to expose to the browser — this app
# is a static export with no server, so access control lives entirely in
# Postgres RLS (see supabase/migrations/).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local-only — used by scripts/seed.ts, never read by the Next.js app itself.
# The service role key bypasses RLS entirely: keep it out of NEXT_PUBLIC_*,
# out of the browser, and out of anything you deploy.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: seed the "owner" account with your real email instead of the
# mock carina@mglagency.com, so you can actually receive its login email.
SEED_OWNER_EMAIL=
